/target
node_modules/
# generated by wasm-pack (mise run build:wasm, from Phase 0)
/web/pkg/
# build:wasm stages a build beside it and swaps it in
/web/.pkg-*/
# emitted by tsc / vite
/web/dist/
/site/dist/
# Playwright's results
/site/test-results/
/site/playwright-report/
# discovery's throwaway benches build into their own target dirs
/discovery/bench/**/target/
/discovery/bench/**/pkg/
/discovery/bench/**/node_modules/
# python's caches
__pycache__/
# elm
elm-stuff/
.DS_Store
# git worktrees Claude Code makes for its agents
/.claude/worktrees/

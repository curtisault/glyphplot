{
  "name": "glyphplot",
  "version": "0.3.0",
  "description": "Interactive charts drawn in Unicode glyphs: a <glyph-plot> element over one wasm module a chart family",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./src/element.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts",
    "pkg"
  ],
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc --noEmit -p .",
    "test": "node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
